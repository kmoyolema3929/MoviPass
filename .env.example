# Copia este archivo como .env y completa los valores. NO subas .env

# Servidor
PORT=8080
CORS_ORIGIN=http://localhost:5500

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movipass
DB_USER=
DB_PASSWORD=

# Autenticación (JWT)
# Usa una cadena larga y aleatoria. Cada persona define la suya, no se comparte
JWT_SECRET=
JWT_EXPIRATION_HOURS=8

# Correo (notificaciones)
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=

# Archivos subidos (comprobantes de pago y fotos de buses)
UPLOAD_DIR=uploads
PROOF_UPLOAD_HOURS=3