# Copia este archivo como .env y completa los valores. NO subas .env
# Solo lo usa quien aplica migraciones a Supabase con la CLI.

# Identificador del proyecto (Project Settings > General > Reference ID)
SUPABASE_PROJECT_REF=

# Token personal de la CLI (supabase.com/dashboard/account/tokens). Cada persona crea el suyo, no se comparte
SUPABASE_ACCESS_TOKEN=

# Contraseña de la base de datos del proyecto. La entrega la persona responsable de migraciones por un canal privado
SUPABASE_DB_PASSWORD=

# NUNCA agregar aquí ni en el frontend la clave service_role
